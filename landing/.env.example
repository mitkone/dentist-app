# Лендинг (Vite, base URL /dentist-tool/)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Stripe Price IDs — в Dashboard продуктите трябва да са с валута EUR:
# • recurring / месец = месечният абонамент (49€ или 89€)
# Еднократната такса 150€ се задава само в secrets на Edge функция STRIPE_SETUP_FEE_PRICE_ID
VITE_STRIPE_PRICE_STARTER=price_xxxxx
VITE_STRIPE_PRICE_PRO=price_xxxxx
